digraph G {
graph [rankdir=LR, fontname="Arial", nodesep=0.15, ranksep=0.35, pad=0.15, newrank=true];
node [fontname="Arial", fontsize=15, shape=box, style="rounded,filled", fillcolor="#F2F2F2", color="#444444", penwidth=1.3, margin="0.08,0.04"];
edge [fontname="Arial", fontsize=13, color="#555555", fontcolor="#222222", arrowsize=0.7];
"PAN-01" [label=<<b>PAN-01</b><br/>Inicio de sesión>];
"PAN-02" [label=<<b>PAN-02</b><br/>Menú principal<br/>(Inicio)>];
"PAN-03" [label=<<b>PAN-03</b><br/>Buscar<br/>expediente>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-04" [label=<<b>PAN-04</b><br/>Detalle del<br/>expediente>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-05" [label=<<b>PAN-05</b><br/>Cargar documento>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-06" [label=<<b>PAN-06</b><br/>Registrar o<br/>modificar<br/>abonado y<br/>personas>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-07" [label=<<b>PAN-07</b><br/>Panel de<br/>completitud>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-08" [label=<<b>PAN-08</b><br/>Respaldo y<br/>restauración>, fillcolor="#D9D9D9", penwidth=2.2];
"PAN-09" [label=<<b>PAN-09</b><br/>Importar datos<br/>de SADA>];
"PAN-10" [label=<<b>PAN-10</b><br/>Tipos de<br/>documento>];
"PAN-11" [label=<<b>PAN-11</b><br/>Bitácora>];
"PAN-12" [label=<<b>PAN-12</b><br/>Exportar<br/>documentos>];
"PAN-13" [label=<<b>PAN-13</b><br/>Historial de<br/>versiones>];
"PAN-14" [label=<<b>PAN-14</b><br/>Mi cuenta>];
"PAN-15" [label=<<b>PAN-15</b><br/>Revisar posibles<br/>duplicados>];
"D-01" [label=<<b>D-01</b><br/>Anular documento>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-02" [label=<<b>D-02</b><br/>Editar datos del<br/>documento>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-03" [label=<<b>D-03</b><br/>Dar de baja o<br/>reactivar abonado>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-04" [label=<<b>D-04</b><br/>Cambiar titular>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-05" [label=<<b>D-05</b><br/>Confirmar<br/>restauración>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-06" [label=<<b>D-06</b><br/>Fusionar personas>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-07" [label=<<b>D-07</b><br/>Salir sin guardar>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"D-08" [label=<<b>D-08</b><br/>Sesión por<br/>cerrarse>, style="rounded,dashed,filled", fillcolor="white", fontsize=14];
"MENU" [label=<<b>Menú lateral y barra superior</b><br/>(en todas las pantallas tras iniciar sesión)<br/><br/>Inicio → PAN-02<br/>Buscar expediente → PAN-03<br/>Nuevo abonado → PAN-06<br/>Completitud → PAN-07<br/>Importar SADA → PAN-09<br/>Posibles duplicados → PAN-15<br/>Tipos de documento → PAN-10<br/>Bitácora → PAN-11<br/>Respaldos → PAN-08<br/>Mi cuenta → PAN-14<br/>Cerrar sesión → PAN-01<br/>15 min sin actividad → D-08>, shape=note, fillcolor="white", fontsize=14];
"PAN-01" -> "MENU" [style=invis];
"PAN-01" -> "PAN-02" [label="Ingresar", style=bold, penwidth=2];
"PAN-02" -> "PAN-08" [label="Aviso respaldo"];
