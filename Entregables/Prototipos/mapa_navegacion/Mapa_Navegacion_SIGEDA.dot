"D-08" [label=<<b>D-08</b><br/>Sesión por cerrarse>, shape=box, style="rounded,dashed,filled", fillcolor="white", fontsize=13];
"MENU" [label=<<b>Menú lateral</b><br/>(en todas las pantallas<br/>después de iniciar sesión)>, shape=folder, fillcolor="#FFFFFF"];
