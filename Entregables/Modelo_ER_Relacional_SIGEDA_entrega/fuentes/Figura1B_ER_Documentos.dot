digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.7, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  GrupoAlternativas [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>GrupoAlternativas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>nombre</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">obligatoriedad</TD></TR></TABLE>>];
  TipoDocumento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>TipoDocumento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>nombre</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">prioridad</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">obligatoriedad <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">es_exigido_a_cotitulares</TD></TR></TABLE>>];
  Documento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Documento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>id_documento</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_identificador <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">motivo_anulacion <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_anulacion <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><I>/version_vigente</I></TD></TR></TABLE>>];
  VersionDocumento [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B2140"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>VersionDocumento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>numero_version</U> <FONT POINT-SIZE="8">(clave parcial)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_original</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">ruta_archivo</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">formato</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tamano_bytes</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_documento</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_carga</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_sha256</TD></TR></TABLE></TD></TR></TABLE>>];
  Abonado [shape=plain, label=<<TABLE BORDER="1" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E9ECF1" COLOR="#7F8C9A"><TR><TD><B>Abonado</B></TD></TR></TABLE>>];
  Persona [shape=plain, label=<<TABLE BORDER="1" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E9ECF1" COLOR="#7F8C9A"><TR><TD><B>Persona</B></TD></TR></TABLE>>];
  Abonado -> Documento [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>tiene_documentos</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Persona -> Documento [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>aporta</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  TipoDocumento -> Documento [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>clasifica</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  GrupoAlternativas -> TipoDocumento [dir=both, arrowtail="teeodot", arrowhead="crowtee", label=<<I>agrupa</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Documento -> VersionDocumento [dir=both, arrowtail="teetee", arrowhead="crowtee", label=<<I>contiene</I>>, penwidth=2.2, fontsize=10, color="#34495E"];
  { rank=same; Abonado; TipoDocumento; Persona }
}
