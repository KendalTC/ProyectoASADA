digraph G {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.7, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  grupo_alternativas [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>grupo_alternativas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_grupo_alternativas</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">obligatoriedad</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR></TABLE>>];
  tipo_documento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>tipo_documento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_tipo_documento</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_grupo_alternativas</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→grupo_alternativas · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">prioridad</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">obligatoriedad</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">es_exigido_a_cotitulares</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR></TABLE>>];
  documento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>documento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_documento</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_abonado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→abonado</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_tipo_documento</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→tipo_documento</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_persona</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→persona · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_identificador</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">motivo_anulacion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_anulacion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  version_documento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>version_documento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_documento</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→documento</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>numero_version</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_original</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">ruta_archivo</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">formato</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tamano_bytes</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_documento</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_carga</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_sha256</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR></TABLE>>];
  abonado [shape=plain, label=<<TABLE BORDER="1" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E9ECF1" COLOR="#7F8C9A"><TR><TD><B>abonado</B></TD></TR></TABLE>>];
  persona [shape=plain, label=<<TABLE BORDER="1" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E9ECF1" COLOR="#7F8C9A"><TR><TD><B>persona</B></TD></TR></TABLE>>];
  abonado -> documento [dir=both, arrowtail="teetee", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  persona -> documento [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  tipo_documento -> documento [dir=both, arrowtail="teetee", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  grupo_alternativas -> tipo_documento [dir=both, arrowtail="teeodot", arrowhead="crowtee", color="#34495E", penwidth=1.2];
  documento -> version_documento [dir=both, arrowtail="teetee", arrowhead="crowtee", color="#34495E", penwidth=1.2];
  { rank=same; grupo_alternativas; abonado; persona }
  { rank=same; tipo_documento; documento }
}
