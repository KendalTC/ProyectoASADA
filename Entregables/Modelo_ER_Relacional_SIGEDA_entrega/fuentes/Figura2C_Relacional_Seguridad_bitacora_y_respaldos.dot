digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.7, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  cuenta [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>cuenta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_cuenta</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">usuario</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_contrasena</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">perfil</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">intentos_fallidos</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">bloqueada_hasta</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">es_contrasena_temporal</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR></TABLE>>];
  registro_bitacora [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>registro_bitacora</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_registro_bitacora</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_cuenta</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→cuenta · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_abonado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">ref. lógica→abonado · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">accion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">elemento_afectado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">origen</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR></TABLE>>];
  registro_modificacion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>registro_modificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_registro_bitacora</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→registro_bitacora</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">campo_modificado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">valor_anterior</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">valor_nuevo</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  registro_restauracion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>registro_restauracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_registro_bitacora</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→registro_bitacora</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_paquete</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_respaldo_restaurado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR></TABLE>>];
  respaldo [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>respaldo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_respaldo</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_cuenta</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→cuenta · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tipo</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_paquete</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_sha256</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tamano_bytes</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  copia_respaldo [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>copia_respaldo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_respaldo</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→respaldo</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>destino</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora_verificacion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  cuenta -> registro_bitacora [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  registro_bitacora -> registro_modificacion [dir=both, arrowtail="teetee", arrowhead="teeodot", color="#34495E", penwidth=1.2];
  registro_bitacora -> registro_restauracion [dir=both, arrowtail="teetee", arrowhead="teeodot", color="#34495E", penwidth=1.2];
  cuenta -> respaldo [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  respaldo -> copia_respaldo [dir=both, arrowtail="teetee", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  { rank=same; registro_bitacora; respaldo }
  { rank=same; registro_modificacion; copia_respaldo }
  registro_modificacion -> registro_restauracion [style=invis];
}
