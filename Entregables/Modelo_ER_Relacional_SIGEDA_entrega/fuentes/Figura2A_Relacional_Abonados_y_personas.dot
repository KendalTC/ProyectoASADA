digraph G {
  graph [rankdir=TB, nodesep=0.6, ranksep=0.8, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  sector [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>sector</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_sector</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR></TABLE>>];
  abonado [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>abonado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_abonado</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">numero_paja</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">id_sector</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">FK→sector · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tipo_abonado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_baja</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  persona [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>persona</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_persona</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tipo_identificacion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK · opc.</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">identificacion</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  vinculo_abonado [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD COLSPAN="2" BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>vinculo_abonado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_abonado</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→abonado</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>id_persona</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK · FK→persona</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><B>fecha_inicio</B></TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">rol</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">CHECK</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_fin</TD><TD ALIGN="LEFT" CELLPADDING="2"><FONT POINT-SIZE="8" COLOR="#5D6D7E">opc.</FONT></TD></TR></TABLE>>];
  sector -> abonado [dir=both, arrowtail="teeodot", arrowhead="crowodot", color="#34495E", penwidth=1.2];
  abonado -> vinculo_abonado [dir=both, arrowtail="teetee", arrowhead="crowtee", color="#34495E", penwidth=1.2];
  persona -> vinculo_abonado [dir=both, arrowtail="teetee", arrowhead="crowtee", color="#34495E", penwidth=1.2];
  { rank=same; sector; persona }
}
