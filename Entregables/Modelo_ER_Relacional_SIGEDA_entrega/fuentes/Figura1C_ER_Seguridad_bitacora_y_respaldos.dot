digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.7, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  Cuenta [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Cuenta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>usuario</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_contrasena</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">perfil</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">intentos_fallidos</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">bloqueada_hasta <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">es_contrasena_temporal</TD></TR></TABLE>>];
  RegistroBitacora [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroBitacora</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>id_registro_bitacora</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">accion</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">elemento_afectado</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">origen</TD></TR></TABLE>>];
  RegistroModificacion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroModificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">campo_modificado</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">valor_anterior <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">valor_nuevo <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR></TABLE>>];
  RegistroRestauracion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroRestauracion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_paquete</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_respaldo_restaurado</TD></TR></TABLE>>];
  Respaldo [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Respaldo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>id_respaldo</U></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tipo</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">nombre_paquete <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">hash_sha256 <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">tamano_bytes <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR></TABLE>>];
  CopiaRespaldo [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B2140"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>CopiaRespaldo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><U>destino</U> <FONT POINT-SIZE="8">(clave parcial)</FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">estado</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2">fecha_hora_verificacion <FONT POINT-SIZE="8">(0..1)</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Abonado [shape=plain, label=<<TABLE BORDER="1" STYLE="DASHED" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E9ECF1" COLOR="#7F8C9A"><TR><TD><B>Abonado</B></TD></TR></TABLE>>];
  Cuenta -> RegistroBitacora [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>realiza</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Abonado -> RegistroBitacora [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>afecta_a</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Cuenta -> Respaldo [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>inicia</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Respaldo -> CopiaRespaldo [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>tiene_copias</I>>, penwidth=2.2, fontsize=10, color="#34495E"];
  RegistroModificacion -> RegistroBitacora [arrowhead=onormal, arrowsize=1.5, color="#34495E", penwidth=1.4, label=<<I>es_un</I>>, fontsize=10];
  RegistroRestauracion -> RegistroBitacora [arrowhead=onormal, arrowsize=1.5, color="#34495E", penwidth=1.4, label=<<I>es_un</I>>, fontsize=10];
  RegistroModificacion -> RegistroRestauracion [style=invis];
  { rank=same; Abonado; Cuenta }
  { rank=same; RegistroBitacora; Respaldo }
  { rank=same; RegistroModificacion; CopiaRespaldo }
}
