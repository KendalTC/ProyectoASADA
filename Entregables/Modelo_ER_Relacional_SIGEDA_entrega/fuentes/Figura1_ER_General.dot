digraph G {
  graph [rankdir=TB, nodesep=0.3, ranksep=0.55, fontname="Carlito", splines=true, pad=0.15, dpi=220];
  node [fontname="Carlito", fontsize=11];
  edge [fontname="Carlito", fontsize=10];

  Sector [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Sector</B></FONT></TD></TR></TABLE>>];
  Abonado [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Abonado</B></FONT></TD></TR></TABLE>>];
  Persona [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Persona</B></FONT></TD></TR></TABLE>>];
  TipoDocumento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>TipoDocumento</B></FONT></TD></TR></TABLE>>];
  GrupoAlternativas [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>GrupoAlternativas</B></FONT></TD></TR></TABLE>>];
  Documento [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Documento</B></FONT></TD></TR></TABLE>>];
  VersionDocumento [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B2140"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>VersionDocumento</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Cuenta [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Cuenta</B></FONT></TD></TR></TABLE>>];
  RegistroBitacora [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroBitacora</B></FONT></TD></TR></TABLE>>];
  RegistroModificacion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroModificacion</B></FONT></TD></TR></TABLE>>];
  RegistroRestauracion [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>RegistroRestauracion</B></FONT></TD></TR></TABLE>>];
  Respaldo [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>Respaldo</B></FONT></TD></TR></TABLE>>];
  CopiaRespaldo [shape=plain, label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#0B2140"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" COLOR="#0B2140" BGCOLOR="#F7F9FC"><TR><TD BGCOLOR="#0B2140" CELLPADDING="4"><FONT COLOR="white"><B>CopiaRespaldo</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  Sector -> Abonado [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>ubica_en</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Abonado -> Documento [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>tiene_documentos</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Persona -> Documento [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>aporta</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  TipoDocumento -> Documento [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>clasifica</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  GrupoAlternativas -> TipoDocumento [dir=both, arrowtail="teeodot", arrowhead="crowtee", label=<<I>agrupa</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Documento -> VersionDocumento [dir=both, arrowtail="teetee", arrowhead="crowtee", label=<<I>contiene</I>>, penwidth=2.2, fontsize=10, color="#34495E"];
  Cuenta -> RegistroBitacora [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>realiza</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Abonado -> RegistroBitacora [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>afecta_a</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Cuenta -> Respaldo [dir=both, arrowtail="teeodot", arrowhead="crowodot", label=<<I>inicia</I>>, penwidth=1.2, fontsize=10, color="#34495E"];
  Respaldo -> CopiaRespaldo [dir=both, arrowtail="teetee", arrowhead="crowodot", label=<<I>tiene_copias</I>>, penwidth=2.2, fontsize=10, color="#34495E"];
  vinculo [shape=diamond, style=filled, fillcolor="#DCE3ED", color="#0B2140", fontsize=10, label=<<I>se_vincula_con</I>>];
  Abonado -> vinculo [dir=both, arrowtail="crowtee", arrowhead=none, color="#34495E", penwidth=1.2];
  vinculo -> Persona [dir=both, arrowtail=none, arrowhead="crowtee", color="#34495E", penwidth=1.2];
  RegistroModificacion -> RegistroBitacora [arrowhead=onormal, arrowsize=1.4, color="#34495E", penwidth=1.4, label=<<I>es_un</I>>, fontsize=10];
  RegistroRestauracion -> RegistroBitacora [arrowhead=onormal, arrowsize=1.4, color="#34495E", penwidth=1.4, label=<<I>es_un</I>>, fontsize=10];
  { rank=same; Persona; TipoDocumento }
  { rank=same; RegistroModificacion; RegistroRestauracion }
}
